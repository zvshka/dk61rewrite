// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Guild entity
model Guild {
  id           String  @id
  prefix       String? @default(".")
  quotesPrefix String  @default("\\") @map("quotes_prefix")

  starboardEmoji   String? @default("⭐") @map("starboard_emoji")
  starboardChannel String? @map("starboard_channel")
  starboardCount   Int     @default(3) @map("starboard_count")
  proposalChannel  String? @map("proposal_channel")

  voiceHubChannel   String? @map("voice_hub_channel")
  voiceCategory     String? @map("voice_category")
  voiceNameTemplate String? @map("voice_name_template")
  voiceDefaultLimit Int?    @map("voice_default_limit")

  deleted Boolean @default(false)

  lastInteract DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  starredMessages StarredMessage[]
  welcomeImages   WelcomeImage[]
  answers         PingAnswer[]
  welcomeMessages WelcomeMessage[]
  proposals       Proposal[]
  tempVoiceRooms  TempVoiceRoom[]
  voiceProfiles   VoiceProfile[]
}

model User {
  id String @id

  lastInteract DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  proposals Proposal[]

  userFor     Proposal[] @relation(name: "usersFor")
  userAgainst Proposal[] @relation(name: "usersAgainst")
}

model Image {
  id String @id @default(nanoid())

  filename   String
  basePath   String   @default("")
  url        String
  size       Int
  tags       String[]
  hash       String
  deleteHash String

  lastInteract DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Stat {
  id             String @id @default(nanoid())
  type           String
  value          String
  additionalData Json?

  createdAt DateTime @default(now())
}

model StarredMessage {
  guild            Guild  @relation(fields: [guildId], references: [id])
  guildId          String
  starredMessageId String
  botMessageId     String

  @@id([guildId, starredMessageId])
}

model WelcomeImage {
  id  Int    @id @default(autoincrement())
  url String

  isApi       Boolean? @default(false)
  pathToImage String?

  guild   Guild  @relation(fields: [guildId], references: [id])
  guildId String
}

model WelcomeMessage {
  id      Int    @id @default(autoincrement())
  text    String
  guild   Guild  @relation(fields: [guildId], references: [id])
  guildId String
}

model PingAnswer {
  id   Int    @id @default(autoincrement())
  text String

  guild   Guild  @relation(fields: [guildId], references: [id])
  guildId String
}

model Proposal {
  id          Int    @id @default(autoincrement())
  text        String
  description String

  author User  @relation(fields: [authorId], references: [id])
  guild  Guild @relation(fields: [guildId], references: [id])

  usersFor     User[] @relation(name: "usersFor")
  usersAgainst User[] @relation(name: "usersAgainst")

  guildId  String
  authorId String

  createdAt         DateTime       @default(now())
  endsAt            DateTime
  proposalMessageId String?        @map("proposal_message_id")
  status            ProposalStatus @default(ACTIVE)
}

enum ProposalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

/// Временный персональный голосовой канал, созданный хабом.
model TempVoiceRoom {
  id String @id @default(nanoid())

  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  guildId String

  channelId String @unique
  ownerId   String

  panelMessageId String? @map("panel_message_id")

  locked    Boolean @default(false)
  userLimit Int     @default(0) @map("user_limit")

  /// когда канал опустел; по истечении таймаута комната удаляется
  emptySince DateTime? @map("empty_since")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
  @@index([ownerId])
  @@index([emptySince])
}

/// Сохранённые настройки персональной комнаты: применяются при каждом новом создании.
model VoiceProfile {
  id String @id @default(nanoid())

  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  guildId String

  ownerId String

  /// переопределение имени; null - имя строится по шаблону сервера
  channelName String? @map("channel_name")

  /// переопределение лимита; null - берётся лимит сервера по умолчанию
  userLimit Int? @map("user_limit")

  locked Boolean @default(false)

  allowedUserIds String[] @default([]) @map("allowed_user_ids")
  deniedUserIds  String[] @default([]) @map("denied_user_ids")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, ownerId])
  @@index([guildId])
}
